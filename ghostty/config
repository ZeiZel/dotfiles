# ============================================
# GHOSTTY - CATPPUCCIN MOCHA THEME
# ============================================

# Theme
theme = "Catppuccin Mocha"

# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 15
font-thicken = true
adjust-cell-height = 15%

# Window
window-decoration = true
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
window-theme = ghostty
window-save-state = default

# Background - light transparency without a continuous blur pass
background-opacity = 0.96
background-blur = false
unfocused-split-opacity = 0.9

# Cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = cursor,no-sudo,title,path

# Mouse
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

# Clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true
copy-on-select = clipboard

# macOS specific
macos-option-as-alt = left
macos-titlebar-style = tabs
macos-window-shadow = true
confirm-close-surface = false

# Scrollback
scrollback-limit = 10000000

# Bell
bell-features = no-system,no-audio,attention,title,no-border

# Links
link-url = true

# Keybindings - terminal-native split fallback outside Herdr
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+w=close_surface
keybind = super+enter=toggle_fullscreen
keybind = super+k=clear_screen

# Tab navigation
keybind = super+t=new_tab
keybind = super+shift+left_bracket=previous_tab
keybind = super+shift+right_bracket=next_tab

