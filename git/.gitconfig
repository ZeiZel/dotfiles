[core]
  attributesfile = ~/.gitattributes
  autocrlf = input
  editor = nvim
  trustctime = false
  excludesfile = ~/.gitignore

# [init]
#  templatedir = ~/.dotfiles/git/gitdir_template

[pager]
  branch = false
  diff = delta -s
  show = delta -s
  log = delta
  reflog = delta

[interactive]
  diffFilter = delta --color-only

[credential]
  useHttpPath = false

[help]
  autocorrect = 1

[status]
  submodulesummary = 1
  # Sometimes a newly-added folder, since it's only one line in git status, can slip under the radar.
  # https://git-scm.com/docs/git-config#git-config-statusshowUntrackedFiles
  showUntrackedFiles = all

[commit]
  verbose = true

[apply]
  whitespace = fix

[branch]
  autosetuprebase = always

[color]
  ui = auto

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = yellow
  frag = magenta # line info
  old = red # deletions
  new = green # additions
  whitespace = red reverse

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[delta]
  features = line-numbers
  syntax-theme = TwoDark
  wrap-max-lines = unlimited

[delta "line-numbers"]
  line-numbers = true
  ; line-numbers-minus-style = "#444444"
  line-numbers-zero-style = "#444444"
  ; line-numbers-plus-style = "#444444"
  hunk-header-decoration-style = "#444444 ul"
  commit-style = 214 ; brightblue
  commit-decoration-style = bold
  file-style = 109 ul ; yellow ul
  file-decoration-style = none
  line-numbers-left-format = "{nm:>4}┊"
  line-numbers-right-format = "{np:>4}│"
  line-numbers-left-style = "#444444"
  line-numbers-right-style = "#444444"


[push]
  default = simple

  # Because I get sick of telling git to do it manually
  # automatically push all tags, reachable from the branches you're pushing
  # https://git-scm.com/docs/git-config#git-config-pushfollowTags
  followTags = true

[diff]
  # Git's built-in nvimdiff driver resolves `nvim` from PATH, so the same
  # configuration works with Intel/Apple Silicon Homebrew and Linuxbrew.
  tool = nvimdiff
  guitool = vscode
  submodule = log
  algorithm = patience
  indentHeuristic = true
  colorMoved = default

[difftool]
  prompt = false

[diff "bin"]
  textconv = hexdump -v -C

[difftool "vscode"]
  cmd = "code -n -w -d \"$LOCAL\" \"$REMOTE\""

[merge]
  # LOCAL | writable MERGED | REMOTE is the familiar three-pane IDE layout.
  # The BASE revision remains available as a loaded Neovim buffer.
  tool = nvimdiff2
  guitool = vscode
  # zdiff3 includes the common ancestor while removing duplicated context.
  conflictStyle = zdiff3

[mergetool]
  keepBackup = false
  hideResolved = true
  prompt = false

[mergetool "vscode"]
  cmd = "code --wait --merge \"$REMOTE\" \"$LOCAL\" \"$BASE\" \"$MERGED\""

[include]
  path = ~/.gitconfig.local

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
