// Zed settings
//
// The Ansible extension provides YAML highlighting with Jinja2 injections.
// This is also the syntax used by rentverse's values.tpl.yaml templates.
// Zed's current injections cover expressions in YAML nodes, not standalone
// `{% ... %}` mapping directives; rendered output remains the validation path.
{
  "agent_ui_font_size": 16.0,
  "markdown_preview_font_size": 16.0,
  "terminal": {
    "font_size": 14.0
  },
  "gutter": {
    "folds": false
  },
  "diff_view_style": "split",
  "icon_theme": "Zed (Default)",
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "project_panel": {
    "hide_root": false,
    "git_status_indicator": true,
    "sticky_scroll": false,
    "dock": "left",
    // Show every directory as its own row instead of collapsing a chain of
    // single-child directories into "deploy/nginx".
    "auto_fold_dirs": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "agent_servers": {
    "claude-acp": {
      "favorite_config_option_values": {
        "model": [
          "opus[1m]"
        ]
      },
      "default_config_options": {
        "mode": "auto",
        "model": "opus[1m]"
      },
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry",
    },
  },
  "base_keymap": "JetBrains",
  // Keep JetBrains' non-modal shortcuts, and add Zed's Vim modal navigation.
  "vim_mode": true,
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha (Blur) [Heavy]",
  },
  "auto_install_extensions": {
    "ansible": true,
    "helm": true,
  },
  "file_types": {
    "Ansible": ["*.tpl.yaml", "*.tpl.yml", "*.yaml.j2", "*.yml.j2"],
    // The Helm extension claims only `.helmignore` on its own, so chart sources
    // open as plain YAML and `{{ ... }}` reads as a syntax error.
    //
    // A `file_types` entry is a path glob. It cannot ask whether `Chart.yaml`
    // sits next to the directory, so "inside a `templates/` directory" is the
    // closest expressible approximation of "inside a chart's templates".
    // A `templates/` directory that holds plain YAML and is not a chart is
    // therefore caught too; override it in that project's `.zed/settings.json`.
    //
    // `*values.yaml` deliberately matches the literal substring rather than
    // `values*.yaml`, which keeps rentverse's `values.tpl.yaml` on the Ansible
    // entry above: those are Jinja2 plus envsubst inputs, not Helm templates.
    "Helm": [
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/templates/**/*.tpl",
      "**/*values.yaml",
      "**/*values.yml",
      "values.yaml",
      "values.yml",
    ],
  },
  "languages": {
    "Ansible": {
      // The source is a Jinja template, not valid YAML until rendered.
      // Validate the rendered output in CI instead of showing false errors here.
      "enable_language_server": false,
      "format_on_save": "off",
    },
    "Python": {
      // Enable ty, disable basedpyright, and keep the other registered
      // language servers available (ruff, pylsp, pyright).
      "language_servers": [
        "ty",
        "!basedpyright",
        "...",
      ],
    },
  },
}
